    <!-- WinUI 3 + WebView2 + Native AOT test host (the only host target of this repo). -->
    <Project Path="src/DemoHost.WinApp/DemoHost.WinApp.csproj" />
    <Project Path="src/Game.BepuDemos.Tests/Game.BepuDemos.Tests.csproj" />
    <Project Path="src/Game.BepuDemos.Tests.Aot/Game.BepuDemos.Tests.Aot.csproj" />
  </Folder>
