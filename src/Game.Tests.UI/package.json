{
  "name": "bepu-demos-tests-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright E2E suite for the BepuPhysics2 demo host (WinUI 3 + WebView2 over CDP).",
  "scripts": {
    "test": "playwright test --config=playwright.winapp.config.ts",
